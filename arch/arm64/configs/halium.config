# UT patches
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# CONFIG_SECURITY_SELINUX is not set
CONFIG_SECURITY_APPARMOR=y

# Fixes for vendor mounting issues
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_SECURITY_SMACK is not set
CONFIG_DEFAULT_SECURITY_APPARMOR=y
