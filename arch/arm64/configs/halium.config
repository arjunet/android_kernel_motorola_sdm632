# UT patches
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# CONFIG_SECURITY_SELINUX is not set
CONFIG_SECURITY_APPARMOR=y

# Fixes for vendor mounting issues
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_SECURITY_SMACK is not set
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# Enable 32-bit Android vendor HAL binaries on the arm64 kernel
CONFIG_COMPAT=y

# Bluetooth: stock Moto/LineageOS disables the kernel BlueZ stack (Android
# uses its own userspace BT stack). UT/Halium runs host BlueZ bridged to the
# container's Android BT HAL by bluebinder, which needs a virtual HCI
# controller (/dev/vhci) plus the classic/LE protocol built in.
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y